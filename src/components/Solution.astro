---
const steps = [
  {
    title: "Input",
    desc: "Endereço ou hash de transação",
    icon: "input",
  },
  {
    title: "Rastreamento",
    desc: "Análise on-chain via Helius API",
    icon: "scan",
  },
  {
    title: "Grafo de Fluxo",
    desc: "Reconstrução visual do trajeto dos fundos",
    icon: "graph",
  },
  {
    title: "Relatório PDF",
    desc: "Parecer técnico assinado, pronto para a corte",
    icon: "doc",
  },
];
---

<section id="solucao" class="section bg-[#12121A] relative overflow-hidden">
  <!-- Decorative side glow -->
  <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(182,155,106,0.06) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="container-x relative">
    <div class="max-w-3xl reveal">
      <p class="label-eyebrow mb-5"><span>A Solução</span></p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight text-balance"
        style="color: var(--color-gold-light);"
      >
        Transformamos uma hash de transação em um relatório forense
        pronto para uso legal — <span class="italic" style="color: var(--color-gold);">em 60 segundos.</span>
      </h2>
      <p class="mt-6 text-base lg:text-lg text-[#8B8575] max-w-2xl leading-relaxed">
        Um pipeline forense automatizado que faz em minutos o que hoje custa milhares e leva semanas.
      </p>
    </div>

    <!-- Pipeline diagram -->
    <div class="mt-16 reveal reveal-delay-2">
      <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4 relative">
        <!-- Connector line (desktop) -->
        <div class="hidden lg:block absolute top-[2.75rem] left-12 right-12 h-px"
          style="background: repeating-linear-gradient(to right, rgba(182,155,106,0.4) 0 6px, transparent 6px 12px);"
          aria-hidden="true"
        ></div>

        {steps.map((s, i) => (
          <li class="relative">
            <div class="card-base card-hover p-6 h-full">
              <div class="flex items-start justify-between">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-[#0A0A0F] border border-[#2A2520] text-[#D4A849] relative z-10">
                  {s.icon === "input" && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="6" width="20" height="12" rx="2"/>
                      <line x1="6" y1="12" x2="14" y2="12"/>
                      <line x1="18" y1="10" x2="18" y2="14"/>
                    </svg>
                  )}
                  {s.icon === "scan" && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="7"/>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                      <line x1="11" y1="8" x2="11" y2="14"/>
                      <line x1="8" y1="11" x2="14" y2="11"/>
                    </svg>
                  )}
                  {s.icon === "graph" && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="6" cy="6" r="2"/>
                      <circle cx="18" cy="6" r="2"/>
                      <circle cx="12" cy="18" r="2"/>
                      <line x1="7.5" y1="7.5" x2="10.5" y2="16.5"/>
                      <line x1="16.5" y1="7.5" x2="13.5" y2="16.5"/>
                      <line x1="8" y1="6" x2="16" y2="6"/>
                    </svg>
                  )}
                  {s.icon === "doc" && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <line x1="8" y1="13" x2="16" y2="13"/>
                      <line x1="8" y1="17" x2="13" y2="17"/>
                    </svg>
                  )}
                </div>
                <span class="font-mono text-xs text-[#8B8575]">0{i + 1}</span>
              </div>
              <h3 class="mt-5 font-display text-xl" style="color: var(--color-gold-light);">{s.title}</h3>
              <p class="mt-2 text-sm text-[#8B8575] leading-relaxed">{s.desc}</p>
            </div>

            {i < steps.length - 1 && (
              <div class="lg:hidden flex justify-center my-2 text-[#B69B6A]/60" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <path d="M12 5v14M5 12l7 7 7-7"/>
                </svg>
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
