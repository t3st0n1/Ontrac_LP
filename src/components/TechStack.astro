---
const stack = [
  { label: "Solana", desc: "L1 blockchain" },
  { label: "Helius", desc: "RPC & data API" },
  { label: "Cytoscape.js", desc: "Graph viz" },
  { label: "Next.js", desc: "App framework" },
  { label: "Supabase", desc: "Backend & auth" },
  { label: "GPT-4", desc: "AI summarization" },
];
---

<section id="tech" class="section bg-[#12121A]">
  <div class="container-x">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 reveal">
        <p class="label-eyebrow mb-5"><span>Stack</span></p>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-[2.75rem] leading-tight text-balance"
          style="color: var(--color-gold-light);"
        >
          Construído na Solana.
        </h2>
        <p class="mt-5 text-base text-[#8B8575] leading-relaxed">
          Infraestrutura de dados via Helius API. Visualização via Cytoscape.js.
          Relatórios com certificação ICP-Brasil.
        </p>
      </div>

      <div class="lg:col-span-7 reveal reveal-delay-2">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {stack.map((s) => (
            <div class="card-base card-hover p-5 flex flex-col gap-1">
              <span class="font-display text-lg" style="color: var(--color-gold-light);">{s.label}</span>
              <span class="text-xs font-mono uppercase tracking-widest text-[#8B8575]">{s.desc}</span>
            </div>
          ))}
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-2 text-xs text-[#8B8575] font-mono">
          <span class="hash-pill">Helius API</span>
          <span class="hash-pill">REST · WebSocket</span>
          <span class="hash-pill">ICP-Brasil signed PDF</span>
        </div>
      </div>
    </div>
  </div>
</section>
