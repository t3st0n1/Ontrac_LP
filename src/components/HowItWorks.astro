---
const steps = [
  {
    n: "01",
    title: "Cole o endereço",
    desc: "Insira o endereço da carteira suspeita ou hash da transação. Sem cadastros longos, sem fricção.",
    sample: "5xT8jNK...K2pQzVfm",
    label: "Carteira suspeita",
  },
  {
    n: "02",
    title: "Visualize o rastro",
    desc: "O OnTrac reconstrói automaticamente o grafo de fluxo de fundos, identificando exchanges, protocolos DeFi e padrões suspeitos.",
    sample: "Binance · Kraken · Jupiter",
    label: "Endpoints identificados",
  },
  {
    n: "03",
    title: "Baixe o relatório",
    desc: "Receba um parecer técnico profissional, assinado por perito credenciado, pronto para anexar à petição judicial.",
    sample: "relatorio_forense.pdf",
    label: "Pronto em 60s",
  },
];
---

<section id="como-funciona" class="section bg-[#0A0A0F]">
  <div class="container-x">
    <div class="max-w-2xl reveal">
      <p class="label-eyebrow mb-5"><span>Workflow</span></p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight text-balance"
        style="color: var(--color-gold-light);"
      >
        Três passos para a recuperação.
      </h2>
    </div>

    <div class="mt-16 relative">
      <!-- Vertical timeline rail -->
      <div class="absolute left-[27px] md:left-[31px] top-0 bottom-0 w-px"
        style="background: linear-gradient(to bottom, transparent, rgba(182,155,106,0.4) 12%, rgba(182,155,106,0.4) 88%, transparent);"
        aria-hidden="true"
      ></div>

      <ol class="space-y-10 md:space-y-14">
        {steps.map((s, i) => (
          <li class={`relative pl-20 md:pl-24 reveal reveal-delay-${i + 1}`}>
            <!-- Number node on rail -->
            <div class="absolute left-0 top-0 w-14 h-14 md:w-16 md:h-16 rounded-full flex items-center justify-center bg-[#0A0A0F] border border-[#2A2520]">
              <span class="absolute inset-0 rounded-full border border-[#B69B6A]/30 anim-graph-pulse" style={`animation-delay: ${i * 0.5}s;`}></span>
              <span class="font-display text-xl"
                style="background: linear-gradient(180deg, #E8E1D6 0%, #B69B6A 100%); -webkit-background-clip: text; background-clip: text; color: transparent;"
              >{s.n}</span>
            </div>

            <div class="grid md:grid-cols-12 gap-6 items-start">
              <div class="md:col-span-7">
                <h3 class="font-display text-2xl md:text-3xl" style="color: var(--color-gold-light);">{s.title}</h3>
                <p class="mt-3 text-base text-[#8B8575] leading-relaxed max-w-xl">{s.desc}</p>
              </div>
              <div class="md:col-span-5">
                <div class="card-base p-5">
                  <p class="text-[10px] uppercase tracking-widest font-mono text-[#8B8575]">{s.label}</p>
                  <p class="mt-2 font-mono text-sm text-[#D4A849] truncate">{s.sample}</p>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
