---
const stats = [
  {
    value: "US$ 2.200+",
    label: "Custo mínimo de um rastreamento forense profissional",
    icon: "dollar",
  },
  {
    value: "85%",
    label: "das vítimas nunca reportam o crime",
    icon: "silence",
  },
  {
    value: "0",
    label: "ferramentas acessíveis para gerar relatórios forenses legais",
    icon: "doc",
  },
];
---

<section id="problema" class="section bg-[#0A0A0F]">
  <div class="container-x">
    <div class="max-w-3xl reveal">
      <p class="label-eyebrow mb-5"><span>O Problema</span></p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl leading-tight text-balance"
        style="color: var(--color-gold-light);"
      >
        US$ 11,4 bilhões perdidos em fraudes cripto em 2025.
        <span class="block mt-2 italic" style="color: var(--color-gold);">A maioria das vítimas não recupera nada.</span>
      </h2>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {stats.map((s, i) => (
        <article class={`card-base card-hover shine p-7 reveal reveal-delay-${i + 1}`}>
          <div class="w-11 h-11 rounded-lg flex items-center justify-center border border-[#2A2520] bg-[#0A0A0F] text-[#B69B6A]">
            {s.icon === "dollar" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="2" x2="12" y2="22"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            )}
            {s.icon === "silence" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 5L6 9H2v6h4l5 4V5z"/>
                <line x1="22" y1="9" x2="16" y2="15"/>
                <line x1="16" y1="9" x2="22" y2="15"/>
              </svg>
            )}
            {s.icon === "doc" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            )}
          </div>
          <p class="mt-6 font-display text-4xl lg:text-5xl"
            style="background: linear-gradient(180deg, #E8E1D6 0%, #B69B6A 100%); -webkit-background-clip: text; background-clip: text; color: transparent;"
          >
            {s.value}
          </p>
          <p class="mt-3 text-sm text-[#8B8575] leading-relaxed">{s.label}</p>
        </article>
      ))}
    </div>
  </div>
</section>
