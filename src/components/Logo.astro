---
interface Props {
  variant?: "full" | "mark";
  class?: string;
}

const { variant = "full", class: className = "" } = Astro.props;
---

{variant === "mark" && (
  <svg
    class={className}
    viewBox="0 0 48 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="markGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D4A849" />
        <stop offset="100%" stop-color="#B69B6A" />
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="46" height="46" rx="10" fill="#0A0A0F" stroke="#2A2520" stroke-width="1" />
    <text
      x="24"
      y="32"
      font-family="'Playfair Display', Georgia, serif"
      font-weight="700"
      font-size="22"
      text-anchor="middle"
      fill="url(#markGrad)"
      letter-spacing="-0.5"
    >OT</text>
  </svg>
)}

{variant === "full" && (
  <span class={`inline-flex items-center gap-2.5 ${className}`}>
    <svg
      width="32"
      height="32"
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="logoGrad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#D4A849" />
          <stop offset="100%" stop-color="#B69B6A" />
        </linearGradient>
      </defs>
      <rect x="1" y="1" width="46" height="46" rx="10" fill="#0A0A0F" stroke="#2A2520" stroke-width="1" />
      <text
        x="24"
        y="32"
        font-family="'Playfair Display', Georgia, serif"
        font-weight="700"
        font-size="22"
        text-anchor="middle"
        fill="url(#logoGrad)"
        letter-spacing="-0.5"
      >OT</text>
    </svg>
    <span
      class="font-display text-[1.375rem] tracking-tight"
      style="color: var(--color-gold-light);"
    >
      OnTrac
    </span>
  </span>
)}
