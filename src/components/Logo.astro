---
import { Image } from "astro:assets";
import logoImage from "../assets/ontrac-logo.jpeg";

interface Props {
  variant?: "full" | "mark";
  class?: string;
}

const { variant = "full", class: className = "" } = Astro.props;
---

<Image
  src={logoImage}
  alt="OnTrac"
  class={`logo-img ${variant === "mark" ? "logo-img--mark" : "logo-img--full"} ${className}`}
  loading="eager"
  decoding="async"
/>

<style>
  .logo-img {
    width: auto;
    object-fit: contain;
    display: block;
  }
  .logo-img--full {
    height: 32px;
  }
  @media (min-width: 1024px) {
    .logo-img--full {
      height: 40px;
    }
  }
  .logo-img--mark {
    height: 32px;
    aspect-ratio: 1 / 1;
    object-position: left center;
  }
</style>
