---
import { Image } from "astro:assets";
import logoImage from "../assets/ontrac-logo.png";

interface Props {
  context?: "header" | "footer";
  class?: string;
}

const { context = "header", class: className = "" } = Astro.props;
---

<Image
  src={logoImage}
  alt="OnTrac"
  class={`logo-img logo-img--${context} ${className}`}
  loading="eager"
  decoding="async"
/>

<style>
  .logo-img {
    width: auto;
    object-fit: contain;
    display: block;
    background: transparent;
  }

  .logo-img--header {
    height: 36px;
  }
  @media (min-width: 1024px) {
    .logo-img--header {
      height: 48px;
    }
  }

  .logo-img--footer {
    height: 40px;
    opacity: 0.8;
  }
</style>
